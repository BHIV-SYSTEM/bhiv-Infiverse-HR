# ============================================
# DATABASE
# ============================================
DATABASE_URL=<YOUR_DATABASE_URL>
MONGODB_URI=<YOUR_MONGODB_URI>
MONGODB_DB_NAME=<YOUR_MONGODB_DB_NAME>

# ============================================
# AUTH / SECURITY
# ============================================
API_KEY_SECRET=<YOUR_API_KEY_SECRET>
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>
CANDIDATE_JWT_SECRET_KEY=<YOUR_CANDIDATE_JWT_SECRET_KEY>
GATEWAY_SECRET_KEY=<YOUR_GATEWAY_SECRET_KEY>

# ============================================
# SERVICE URLS
# ============================================
GATEWAY_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:9000
LANGGRAPH_SERVICE_URL=http://localhost:9001
PORTAL_SERVICE_URL=http://localhost:8501
CLIENT_PORTAL_SERVICE_URL=http://localhost:8502
CANDIDATE_PORTAL_SERVICE_URL=http://localhost:8503

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://sampada.blackholeinfiverse.com,https://infiverse-hr.vercel.app

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SEMANTIC=true
ENABLE_AUTO_SYNC=true
ENABLE_VALUES_ASSESSMENT=true
ENABLE_LEARNING_ENGINE=true

# ============================================
# PERFORMANCE
# ============================================
MAX_CANDIDATES_PER_REQUEST=50
AI_MATCHING_TIMEOUT=15
AGENT_MATCH_TIMEOUT=60
DATABASE_POOL_SIZE=10

# ============================================
# LOCAL PORTS
# ============================================
GATEWAY_PORT=8000
AGENT_PORT=9000
LANGGRAPH_PORT=9001
PORTAL_PORT=8501
CLIENT_PORTAL_PORT=8502
CANDIDATE_PORTAL_PORT=8503

# ============================================
# HUGGING FACE / TRANSFORMERS
# ============================================
HF_TOKEN=<YOUR_HF_TOKEN>
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_PROGRESS_BARS=1
TRANSFORMERS_VERBOSITY=error
TOKENIZERS_PARALLELISM=false

# ============================================
# RUNTIME / LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
OBSERVABILITY_ENABLED=true
PYTHON_VERSION=3.12.7

# ============================================
# COMMUNICATION INTEGRATIONS
# ============================================
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_WHATSAPP_NUMBER=<YOUR_TWILIO_WHATSAPP_NUMBER>
GMAIL_EMAIL=<YOUR_GMAIL_EMAIL>
RECOVERY_CODE=<YOUR_RECOVERY_CODE>
GMAIL_APP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_USERNAME=<YOUR_TELEGRAM_BOT_USERNAME>
TELEGRAM_ADMIN_CHAT_ID=<YOUR_TELEGRAM_ADMIN_CHAT_ID>

# ============================================
# GEMINI
# ============================================
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=<YOUR_GEMINI_MODEL>

# ============================================
# RESUME / KEYWORDS
# ============================================
RESUME_KEYWORDS_URL=<YOUR_RESUME_KEYWORDS_URL>

# ============================================
# WORKFLOW BRIDGE
# ============================================
WORKFLOW_API_BASE_URL=http://127.0.0.1:5000/api
WORKFLOW_API_URL=<YOUR_WORKFLOW_API_URL_OPTIONAL_ALIAS>
WORKFLOW_BRIDGE_EMAIL=<WORKFLOW_USER_EMAIL>
WORKFLOW_BRIDGE_PASSWORD=<WORKFLOW_USER_PASSWORD>
WORKFLOW_USER_PASSWORD=<COMPLETE_INFIVERSE_PASSWORD_FOR_EMPLOYEES>

WORKFLOW_API_BASE_URL_DOCKER=http://host.docker.internal:5000/api
WORKFLOW_TOKEN_REFRESH_SECONDS=43200

# ============================================
# PRAVESH (blackhole_auth) SSO + SAMPADA -> HACKAVERSE ENROLMENT
# Loaded automatically from backend/.env by services/gateway/app/main.py
# ============================================
# Shared HS256 secret with blackhole_auth/backend/.env (its JWT_SECRET value).
# Leave empty to disable the SSO bridge entirely.
PRAVESH_JWT_SECRET=
# This app's slug in Blackhole's product registry
PRAVESH_APP_SLUG=sampada
PRAVESH_COOKIE_NAME=blackhole_token
# false = any signed-in Blackhole account may open this product (default);
# true  = enforce the per-app allow-list carried in the token
PRAVESH_REQUIRE_APP_CLAIM=false
# Where the versioned candidate.enrolment.v1 envelope is delivered.
# Empty = envelope is built but reported SIMULATED (never reported as LIVE).
HACKAVERSE_ENROLMENT_URL=http://localhost:8100/enrolment/ingest
# X-API-Key accepted by HackaVerse (the API_KEY in hackathon/.env)
HACKAVERSE_ENROLMENT_API_KEY=
