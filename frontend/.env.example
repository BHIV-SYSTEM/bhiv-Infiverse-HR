# Copy to .env and adjust. .env is gitignored.
#
# LOCAL DEV (default): services on your machine
VITE_API_BASE_URL=http://localhost:8000
VITE_AGENT_SERVICE_URL=http://localhost:9000
VITE_LANGGRAPH_SERVICE_URL=http://localhost:9001

# Control Center (/control route + sidebar link)
VITE_ENABLE_CONTROL_CENTER=true

# Governance panel tab inside Control Center (org/policy/challenge/decision visibility)
VITE_ENABLE_GOVERNANCE=true

# Pravesh Single Auth SSO base URL
VITE_PRAVESH_URL=pravesh_URL

# Optional: Supabase (if auth features use it)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

#
# PRODUCTION (Vercel): set these in the Vercel dashboard (not in committed .env)
# VITE_API_BASE_URL=https://your-gateway.onrender.com
# VITE_AGENT_SERVICE_URL=https://your-agent.onrender.com
# VITE_LANGGRAPH_SERVICE_URL=https://your-langgraph.onrender.com
# VITE_ENABLE_CONTROL_CENTER=true
# VITE_ENABLE_GOVERNANCE=true
# VITE_PRAVESH_URL=pravesh_URL
# VITE_API_KEY=<YOUR_API_KEY>
