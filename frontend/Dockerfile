FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json .
RUN npm ci

COPY . .

# Ingest build-time environment arguments for Vite bundler
ARG VITE_API_BASE_URL
ARG VITE_AGENT_SERVICE_URL
ARG VITE_LANGGRAPH_SERVICE_URL
ARG VITE_ENABLE_GOVERNANCE
ARG VITE_ENABLE_CONTROL_CENTER
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_PRAVESH_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AGENT_SERVICE_URL=$VITE_AGENT_SERVICE_URL
ENV VITE_LANGGRAPH_SERVICE_URL=$VITE_LANGGRAPH_SERVICE_URL
ENV VITE_ENABLE_GOVERNANCE=$VITE_ENABLE_GOVERNANCE
ENV VITE_ENABLE_CONTROL_CENTER=$VITE_ENABLE_CONTROL_CENTER
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_PRAVESH_URL=$VITE_PRAVESH_URL

RUN npm run build

# # Production stage
FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

RUN adduser --disabled-password --gecos "" frontend

RUN mkdir -p /app/data/cache && \
    chown -R frontend:frontend /app

USER frontend

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]